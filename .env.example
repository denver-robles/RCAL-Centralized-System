# Copy this file to `.env` and adjust the values.
# `.env` is git-ignored — never commit real secrets.

# --- Flask ---------------------------------------------------------------
FLASK_ENV=development
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# --- Database ------------------------------------------------------------
# Leave DATABASE_URL commented out to use SQLite (instance/rcal.db).
#
# MySQL (as used by the sibling portal project):
# DATABASE_URL=mysql+mysqlconnector://root:@localhost/rcal
#
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://rcal:secret@localhost/rcal
#
# DATABASE_URL=

# --- Application ---------------------------------------------------------
ITEMS_PER_PAGE=25

# --- Initial administrator created by `flask init-db --seed` -------------
RCAL_ADMIN_USERNAME=admin
RCAL_ADMIN_PASSWORD=admin123
RCAL_ADMIN_EMAIL=chancery@rcal.local
RCAL_ADMIN_NAME=Chancery Administrator
